NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Address search
ADDRESS_SEARCH_URL=https://your-address-search-api.example.com
ADDRESS_SEARCH_SECRET=replace-with-a-long-random-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM="App Name <noreply@example.com>"

# New order notification (internal): send new order details to this email
NEW_ORDER_NOTIFY_EMAIL=orders@example.com