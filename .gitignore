# =============================================================================
# IDE Configuration (Selective)
# =============================================================================

# VS Code - Keep professional configs, ignore user-specific
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/snippets.code-snippets
!.vscode/tasks.json

# WebStorm/IntelliJ - Keep professional configs, ignore user-specific
/.idea/
# Re-include our professional configurations
!/.idea/codeStyles/
!/.idea/inspectionProfiles/
!/.idea/jsLibraryMappings.xml
!/.idea/webResources.xml
!/.idea/webstorm-settings.xml
!/.idea/prettier.xml
/.cursor/
/.agents/
!/.idea/vcs.xml
!/.idea/modules.xml
!/.idea/*.iml
# Always ignore user-specific files
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/misc.xml
.idea/jarRepositories.xml

